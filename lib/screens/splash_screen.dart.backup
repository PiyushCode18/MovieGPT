import 'dart:math' as math;

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../state/auth_providers.dart';
import '../theme/app_theme.dart';
import 'login_screen.dart';
import 'main_navigation_screen.dart';

/// A premium, superhero-inspired cinematic splash intro for MovieGPT.
///
/// TIMELINE (total = exactly 4.5s):
///  - 0.0–0.9s : Dark cinematic background with moving light rays + smoke.
///               A glowing metallic "M" bursts in (scale + fade) with blue/red
///               energy particles, floating sparks and energy fragments.
///  - 0.9–2.0s : Golden lens-flare sweep crosses the "M"; a light streak races
///               across the screen; the metallic "MovieGPT" wordmark fades in.
///  - 2.0–4.1s : Heroic hold: camera zooms slightly, energy pulses, sparks
///               continue drifting, glow breathes.
///  - 4.1–4.5s : Smooth fade-out, then navigate to Home/Login.
///
/// Implementation keeps a single master [AnimationController] for the sequence
/// plus one repeating controller for the particle field. All custom painting is
/// done in a single [CustomPainter] (GPU-accelerated, cheap per frame). No
/// allocations per frame and every controller is disposed.
class SplashScreen extends ConsumerStatefulWidget {
  const SplashScreen({super.key});

  @override
  ConsumerState<SplashScreen> createState() => _SplashScreenState();
}

class _SplashScreenState extends ConsumerState<SplashScreen>
    with TickerProviderStateMixin {
  // Master timeline controller (exactly 4.5 seconds).
  late final AnimationController _time;

  // "M" entrance (0.0–0.9s scale + fade burst).
  late final Animation<double> _letterScale;
  late final Animation<double> _letterFade;

  // "MovieGPT" entrance (0.9–2.0s).
  late final Animation<double> _wordFade;
  late final Animation<double> _wordScale;

  // Golden lens-flare sweep (0.9–2.0s).
  late final Animation<double> _flare;

  // Light streak across the screen (0.9–2.2s).
  late final Animation<double> _streak;

  // Gentle glow pulse (0.9–4.5s).
  late final Animation<double> _glowPulse;

  // Slow cinematic camera zoom (0.6–4.5s).
  late final Animation<double> _zoom;

  // Final fade-out (4.1–4.5s).
  late final Animation<double> _outroFade;

  bool _navigated = false;

  @override
  void initState() {
    super.initState();
    _time = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 4500),
    );

    // "M" bursts from 0.4 → 1.0 and fades in across 0.0 → 0.9s.
    _letterScale = Tween<double>(begin: 0.4, end: 1.0).animate(
      CurvedAnimation(
        parent: _time,
        curve: const Interval(0.00, 0.20, curve: Curves.easeOutBack),
      ),
    );
    _letterFade = CurvedAnimation(
      parent: _time,
      curve: const Interval(0.00, 0.20, curve: Curves.easeOut),
    );

    // "MovieGPT" fades + scales in across 0.9 → 2.0s.
    _wordFade = CurvedAnimation(
      parent: _time,
      curve: const Interval(0.20, 0.44, curve: Curves.easeOut),
    );
    _wordScale = Tween<double>(begin: 0.86, end: 1.0).animate(
      CurvedAnimation(
        parent: _time,
        curve: const Interval(0.20, 0.44, curve: Curves.easeOutCubic),
      ),
    );

    // Golden lens-flare sweep follows the reveal (0.9 → 2.0s).
    _flare = Tween<double>(begin: -0.4, end: 1.4).animate(
      CurvedAnimation(
        parent: _time,
        curve: const Interval(0.20, 0.44, curve: Curves.easeInOutCubic),
      ),
    );

    // Light streak races across the screen (0.9 → 2.2s).
    _streak = Tween<double>(begin: -0.3, end: 1.3).animate(
      CurvedAnimation(
        parent: _time,
        curve: const Interval(0.20, 0.48, curve: Curves.easeInOut),
      ),
    );

    // Soft glow pulse (breathing) from 0.9s to the end.
    _glowPulse = Tween<double>(begin: 0.6, end: 1.0).animate(
      CurvedAnimation(
        parent: _time,
        curve: const Interval(0.20, 1.00, curve: Curves.easeInOutSine),
      ),
    );

    // Slow cinematic camera zoom (0.6 → 4.5s).
    _zoom = Tween<double>(begin: 1.0, end: 1.09).animate(
      CurvedAnimation(
        parent: _time,
        curve: const Interval(0.13, 1.00, curve: Curves.easeInOut),
      ),
    );

    // Outro fade-out (4.1 → 4.5s).
    _outroFade = CurvedAnimation(
      parent: _time,
      curve: const Interval(0.91, 1.00, curve: Curves.easeIn),
    );

    _time.forward();

    // Schedule navigation at exactly 4.5s.
    Future.delayed(const Duration(milliseconds: 4500), _finish);
  }

  @override
  void dispose() {
    _time.dispose();
    super.dispose();
  }

  /// Route based on the resolved auth state after the intro completes.
  void _finish() {
    if (_navigated || !mounted) return;
    Widget destination;
    try {
      final auth = ref.read(authStateProvider).valueOrNull;
      destination = auth != null
          ? const MainNavigationScreen()
          : const LoginScreen();
    } catch (_) {
      destination = const LoginScreen();
    }
    _routeTo(destination);
  }

  void _routeTo(Widget destination) {
    if (_navigated || !mounted) return;
    _navigated = true;
    Navigator.of(context).pushReplacement(
      PageRouteBuilder(
        pageBuilder: (context, animation, secondaryAnimation) => destination,
        transitionsBuilder: (context, animation, secondaryAnimation, child) =>
            FadeTransition(opacity: animation, child: child),
        transitionDuration: const Duration(milliseconds: 650),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    // Keep the auth stream watched so the intro resolves the correct route.
    ref.watch(authStateProvider);

    return Scaffold(
      backgroundColor: Colors.black,
      body: ColoredBox(
        color: Colors.black,
        child: AnimatedBuilder(
          animation: _time,
          builder: (context, _) {
            // Apply the outro fade-out.
            final opacity = (1.0 - _outroFade.value).clamp(0.0, 1.0);
            return Opacity(
              opacity: opacity,
              child: Stack(
                fit: StackFit.expand,
                children: [
                  // Cinematic smoke / nebula + moving light rays.
                  const _CinematicBackdrop(),
                  // Blue + red energy particles, floating sparks and
                  // energy fragments (single GPU CustomPainter).
                  const _EnergyField(),
                  // Light streak animation racing across the screen.
                  _LightStreak(progress: _streak.value),
                  // Slight camera zoom on the whole content.
                  Transform.scale(
                    scale: _zoom.value,
                    alignment: Alignment.center,
                    child: Center(
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          // Glowing metallic "M" (burst + fade entrance).
                          Opacity(
                            opacity: _letterFade.value,
                            child: Transform.scale(
                              scale: _letterScale.value,
                              child: _GlowingLetter(
                                flare: _flare.value,
                                glow: _glowPulse.value,
                              ),
                            ),
                          ),
                          const SizedBox(height: 10),
                          // Metallic "MovieGPT" wordmark (fade + scale).
                          Opacity(
                            opacity: _wordFade.value,
                            child: Transform.scale(
                              scale: _wordScale.value,
                              child: const _MetallicWordMark(),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ],
              ),
            );
          },
        ),
      ),
    );
  }
}

/// Dark cinematic smoke / nebula backdrop with slowly moving light rays.
///
/// Uses a single [CustomPainter] with radial gradients + rotating light bands
/// driven by a repeating controller. Cheap to render (GPU shader gradients).
class _CinematicBackdrop extends StatefulWidget {
  const _CinematicBackdrop();

  @override
  State<_CinematicBackdrop> createState() => _CinematicBackdropState();
}

class _CinematicBackdropState extends State<_CinematicBackdrop>
    with SingleTickerProviderStateMixin {
  late final AnimationController _c;

  @override
  void initState() {
    super.initState();
    _c = AnimationController(vsync: this, duration: const Duration(seconds: 6))
      ..repeat();
  }

  @override
  void dispose() {
    _c.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _c,
      builder: (context, _) =>
          CustomPaint(size: Size.infinite, painter: _BackdropPainter(_c.value)),
    );
  }
}

/// Blue + red energy particles, floating sparks, and energy fragments.
///
/// Pre-generates a fixed set of particles (seeded) so there are no allocations
/// per frame. One [CustomPainter] draws everything for GPU efficiency.
class _EnergyField extends StatefulWidget {
  const _EnergyField();

  @override
  State<_EnergyField> createState() => _EnergyFieldState();
}

class _EnergyFieldState extends State<_EnergyField>
    with SingleTickerProviderStateMixin {
  late final AnimationController _c;
  late final List<_EnergyParticle> _blue;
  late final List<_EnergyParticle> _red;
  late final List<_Spark> _sparks;
  late final List<_Fragment> _fragments;

  @override
  void initState() {
    super.initState();
    _c = AnimationController(vsync: this, duration: const Duration(seconds: 5))
      ..repeat();
    final rnd = math.Random(42);
    _blue = List.generate(28, (i) => _EnergyParticle.random(rnd, isRed: false));
    _red = List.generate(22, (i) => _EnergyParticle.random(rnd, isRed: true));
    _sparks = List.generate(14, (i) => _Spark.random(rnd));
    _fragments = List.generate(8, (i) => _Fragment.random(rnd));
  }

  @override
  void dispose() {
    _c.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _c,
      builder: (context, _) => CustomPaint(
        size: Size.infinite,
        painter: _EnergyPainter(
          _c.value,
          blue: _blue,
          red: _red,
          sparks: _sparks,
          fragments: _fragments,
        ),
      ),
    );
  }
}

/// A light streak that races across the screen (cinematic energy bolt).
class _LightStreak extends StatelessWidget {
  final double progress;
  const _LightStreak({required this.progress});

  @override
  Widget build(BuildContext context) {
    return Positioned(
      left: progress * 400 - 200,
      top: -40,
      bottom: -40,
      width: 90,
      child: IgnorePointer(
        child: Opacity(
          opacity: progress < 0.05 || progress > 0.95 ? 0.0 : 0.55,
          child: Container(
            decoration: BoxDecoration(
              gradient: LinearGradient(
                colors: [
                  Colors.transparent,
                  Colors.white.withValues(alpha: 0.9),
                  AppTheme.goldAccent.withValues(alpha: 0.6),
                  Colors.transparent,
                ],
                stops: const [0.0, 0.45, 0.55, 1.0],
              ),
            ),
            transform: Matrix4.rotationZ(0.12),
          ),
        ),
      ),
    );
  }
}

/// The large glowing metallic "M" with a golden lens-flare sweep.
class _GlowingLetter extends StatelessWidget {
  final double flare;
  final double glow;
  const _GlowingLetter({required this.flare, required this.glow});

  @override
  Widget build(BuildContext context) {
    return ShaderMask(
      shaderCallback: (bounds) => const LinearGradient(
        colors: [
          Color(0xFFD7DCE3), // bright silver
          Color(0xFFF9FAFB), // near-white highlight
          Color(0xFF9CA3AF), // mid silver
          Color(0xFF4B5563), // dark silver
        ],
        begin: Alignment.topLeft,
        end: Alignment.bottomRight,
      ).createShader(bounds),
      child: Stack(
        clipBehavior: Clip.none,
        children: [
          Text(
            'M',
            style: TextStyle(
              fontSize: 170,
              fontWeight: FontWeight.w900,
              color: Colors.white,
              height: 1.0,
              shadows: [
                Shadow(
                  color: AppTheme.goldAccent.withValues(alpha: 0.6 * glow),
                  blurRadius: 34 * glow,
                ),
                Shadow(
                  color: AppTheme.primaryRed.withValues(alpha: 0.35 * glow),
                  blurRadius: 70 * glow,
                ),
                Shadow(
                  color: const Color(0x884265E2).withValues(alpha: 0.5 * glow),
                  blurRadius: 46 * glow,
                ),
              ],
            ),
          ),
          // Golden lens-flare sweep overlay travelling left → right.
          Positioned(
            left: flare * 220 - 200,
            top: -30,
            bottom: -30,
            width: 50,
            child: IgnorePointer(
              child: Container(
                decoration: BoxDecoration(
                  gradient: LinearGradient(
                    colors: [
                      Colors.transparent,
                      Colors.white.withValues(alpha: 0.9),
                      AppTheme.goldAccent.withValues(alpha: 0.7),
                      Colors.transparent,
                    ],
                    stops: const [0.0, 0.4, 0.6, 1.0],
                  ),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}

/// Metallic "MovieGPT" wordmark with a silver→gold gradient + glow.
class _MetallicWordMark extends StatelessWidget {
  const _MetallicWordMark();

  @override
  Widget build(BuildContext context) {
    return ShaderMask(
      shaderCallback: (bounds) => const LinearGradient(
        colors: [
          Color(0xFFE5E7EB), // silver
          Color(0xFFF9FAFB), // white highlight
          Color(0xFFF59E0B), // gold
          Color(0xFF9CA3AF), // silver
        ],
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
      ).createShader(bounds),
      child: const Text(
        'MovieGPT',
        style: TextStyle(
          fontSize: 36,
          fontWeight: FontWeight.w800,
          letterSpacing: 5,
          color: Colors.white,
          shadows: [
            Shadow(color: Color(0x66FFFFFF), blurRadius: 22),
            Shadow(color: Color(0x55F59E0B), blurRadius: 12),
          ],
        ),
      ),
    );
  }
}

/// --- Data structures for the energy field ---

class _EnergyParticle {
  final double x;
  final double y;
  final double r;
  final double speed;
  final double drift;
  final double alpha;
  final bool isRed;
  _EnergyParticle({
    required this.x,
    required this.y,
    required this.r,
    required this.speed,
    required this.drift,
    required this.alpha,
    required this.isRed,
  });

  factory _EnergyParticle.random(math.Random rnd, {required bool isRed}) {
    return _EnergyParticle(
      x: rnd.nextDouble(),
      y: rnd.nextDouble(),
      r: 0.6 + rnd.nextDouble() * 2.2,
      speed: 0.02 + rnd.nextDouble() * 0.05,
      drift: 0.5 + rnd.nextDouble() * 1.6,
      alpha: 0.2 + rnd.nextDouble() * 0.55,
      isRed: isRed,
    );
  }
}

class _Spark {
  final double x;
  final double y;
  final double length;
  final double angle;
  final double speed;
  final double alpha;
  _Spark({
    required this.x,
    required this.y,
    required this.length,
    required this.angle,
    required this.speed,
    required this.alpha,
  });

  factory _Spark.random(math.Random rnd) {
    return _Spark(
      x: rnd.nextDouble(),
      y: rnd.nextDouble(),
      length: 6 + rnd.nextDouble() * 14,
      angle: rnd.nextDouble() * math.pi * 2,
      speed: 0.03 + rnd.nextDouble() * 0.06,
      alpha: 0.3 + rnd.nextDouble() * 0.5,
    );
  }
}

class _Fragment {
  final double x;
  final double y;
  final double size;
  final double angle;
  final double spin;
  final double speed;
  final bool isRed;
  _Fragment({
    required this.x,
    required this.y,
    required this.size,
    required this.angle,
    required this.spin,
    required this.speed,
    required this.isRed,
  });

  factory _Fragment.random(math.Random rnd) {
    return _Fragment(
      x: rnd.nextDouble(),
      y: rnd.nextDouble(),
      size: 2.5 + rnd.nextDouble() * 4.0,
      angle: rnd.nextDouble() * math.pi * 2,
      spin: 0.5 + rnd.nextDouble() * 1.5,
      speed: 0.01 + rnd.nextDouble() * 0.03,
      isRed: rnd.nextBool(),
    );
  }
}

/// Dark nebula + rotating light rays painter.
class _BackdropPainter extends CustomPainter {
  final double t;
  _BackdropPainter(this.t);

  @override
  void paint(Canvas canvas, Size size) {
    // Base dark background.
    canvas.drawRect(
      Offset.zero & size,
      Paint()..color = const Color(0xFF05050A),
    );

    // Deep blue nebula glow (top-left).
    final blueGlow = Paint()
      ..shader =
          RadialGradient(
            colors: [
              const Color(0xFF16306E).withValues(alpha: 0.5),
              Colors.transparent,
            ],
          ).createShader(
            Rect.fromCircle(
              center: Offset(size.width * 0.2, size.height * 0.25),
              radius: size.width * 0.7,
            ),
          );
    canvas.drawRect(Offset.zero & size, blueGlow);

    // Red nebula glow (bottom-right).
    final redGlow = Paint()
      ..shader =
          RadialGradient(
            colors: [
              const Color(0xFF6E1616).withValues(alpha: 0.45),
              Colors.transparent,
            ],
          ).createShader(
            Rect.fromCircle(
              center: Offset(size.width * 0.85, size.height * 0.85),
              radius: size.width * 0.7,
            ),
          );
    canvas.drawRect(Offset.zero & size, redGlow);

    // Rotating light rays (4 bands) emanating from the center.
    final center = Offset(size.width * 0.5, size.height * 0.42);
    final rayPaint = Paint()
      ..shader = SweepGradient(
        startAngle: t * 2 * math.pi,
        endAngle: t * 2 * math.pi + 2 * math.pi,
        colors: [
          Colors.transparent,
          const Color(0xFF3A5BA0).withValues(alpha: 0.12),
          Colors.transparent,
          const Color(0xFF8F2A2A).withValues(alpha: 0.10),
          Colors.transparent,
        ],
        stops: const [0.0, 0.2, 0.45, 0.7, 1.0],
        transform: const GradientRotation(0),
      ).createShader(Rect.fromCircle(center: center, radius: size.width));
    canvas.drawRect(Offset.zero & size, rayPaint);
  }

  @override
  bool shouldRepaint(covariant _BackdropPainter oldDelegate) => true;
}

/// Blue/red energy particles + sparks + fragments painter.
class _EnergyPainter extends CustomPainter {
  final double t;
  final List<_EnergyParticle> blue;
  final List<_EnergyParticle> red;
  final List<_Spark> sparks;
  final List<_Fragment> fragments;

  _EnergyPainter(
    this.t, {
    required this.blue,
    required this.red,
    required this.sparks,
    required this.fragments,
  });

  @override
  void paint(Canvas canvas, Size size) {
    // Energy particles (blue then red).
    for (final p in blue) {
      _drawParticle(canvas, size, p, AppTheme.aiAzure);
    }
    for (final p in red) {
      _drawParticle(canvas, size, p, AppTheme.primaryRed);
    }

    // Floating sparks (short glowing streaks).
    for (final s in sparks) {
      final y = (s.y - t * s.speed) % 1.0;
      final x = (s.x + math.sin((t * 1.3 + s.x) * 2) * 0.02) % 1.0;
      final px = x * size.width;
      final py = y * size.height;
      final dx = math.cos(s.angle) * s.length;
      final dy = math.sin(s.angle) * s.length;
      final paint = Paint()
        ..shader =
            LinearGradient(
              colors: [
                Colors.white.withValues(alpha: s.alpha),
                Colors.white.withValues(alpha: 0.0),
              ],
            ).createShader(
              Rect.fromPoints(Offset(px, py), Offset(px + dx, py + dy)),
            )
        ..strokeWidth = 1.4
        ..strokeCap = StrokeCap.round;
      canvas.drawLine(Offset(px, py), Offset(px + dx, py + dy), paint);
    }

    // Energy fragments (small rotating polygons).
    for (final f in fragments) {
      final y = (f.y - t * f.speed) % 1.0;
      final x = (f.x + math.sin((t * f.spin + f.x) * 2) * 0.015) % 1.0;
      final px = x * size.width;
      final py = y * size.height;
      final angle = f.angle + t * f.spin * 2;
      final color = f.isRed
          ? AppTheme.primaryRed.withValues(alpha: 0.7)
          : AppTheme.aiAzure.withValues(alpha: 0.7);
      final paint = Paint()..color = color;
      final path = Path();
      final half = f.size;
      path.moveTo(px + half, py);
      path.lineTo(px + half * 0.3, py + half * 0.7);
      path.lineTo(px - half * 0.5, py + half * 0.2);
      path.lineTo(px - half * 0.2, py - half * 0.6);
      path.close();
      canvas.save();
      canvas.translate(px, py);
      canvas.rotate(angle);
      canvas.translate(-px, -py);
      canvas.drawPath(path, paint);
      canvas.restore();
    }
  }

  void _drawParticle(Canvas canvas, Size size, _EnergyParticle p, Color base) {
    final y = (p.y - t * p.speed) % 1.0;
    final x = (p.x + math.sin((t * p.drift + p.x) * 2) * 0.015) % 1.0;
    final px = x * size.width;
    final py = y * size.height;
    final glow = Paint()
      ..color = base.withValues(alpha: p.alpha * 0.35)
      ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 6);
    canvas.drawCircle(Offset(px, py), p.r * 2.2, glow);
    final core = Paint()..color = base.withValues(alpha: p.alpha);
    canvas.drawCircle(Offset(px, py), p.r, core);
  }

  @override
  bool shouldRepaint(covariant _EnergyPainter oldDelegate) => true;
}
